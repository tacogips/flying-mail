{
  "name": "flying-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-domain mailer on Cloudflare Workers with a GraphQL API for AI agents",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run && bun run --cwd apps/web test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "bun run --cwd apps/web build",
    "clean": "rm -rf apps/web/dist apps/api/dist apps/cli/dist",
    "lint:biome": "biome check . --diagnostic-level=warn",
    "lint": "biome check . --diagnostic-level=warn && bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:packages": "vitest run",
    "test:web": "bun run --cwd apps/web test"
  },
  "license": "MIT",
  "trustedDependencies": [],
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@vitest/ui": "4.1.12",
    "typescript": "5.7.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@fastify/busboy": "3.2.3",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "undici@7": "7.30.1",
    "undici@8": "8.12.2"
  }
}
