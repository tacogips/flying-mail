  },
  "dependencies": {
    "@flying-mail/realtime-client": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.7.2"
  }
}
